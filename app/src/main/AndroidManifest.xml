<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:tools="http://schemas.android.com/tools">

  <uses-permission android:name="android.permission.CAMERA" />
  <uses-feature android:name="android.hardware.camera" android:required="false" />
  <uses-permission android:name="android.permission.INTERNET" />
  <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
  <!-- 关于页自更新：从 GitHub Releases 下 APK 后交给系统安装器 -->
  <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
  <!-- 会话保活：CPU 唤醒锁 + Wi-Fi 锁，只在会话真的在跑一轮任务时持有 -->
  <uses-permission android:name="android.permission.WAKE_LOCK" />
  <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
  <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
  <!--
    仅本地热点：纯流量冷启动时点亮 WiFi 射频，不连任何网、也不开个人热点。
    Android 13+ 走「附近的设备」，声明 neverForLocation，不要位置。
  -->
  <uses-permission
    android:name="android.permission.NEARBY_WIFI_DEVICES"
    android:usesPermissionFlags="neverForLocation"
    tools:targetApi="33" />
  <!--
    壳进程（uid 2000）第一次拉起时 pm grant 给自己。之后 App 就能写
    adb_wifi_enabled，纯流量冷启动不必再进开发者选项。卸载会收回。
  -->
  <uses-permission
    android:name="android.permission.WRITE_SECURE_SETTINGS"
    tools:ignore="ProtectedPermissions" />

  <!--
    整机文件：设置里「让 agent 读写这台设备」开了之后，把共享存储挂进 rootfs 的 /sdcard。
    **默认不申请、不影响任何已有功能**——不开这一档时 agent 只看得见 /workspace。

    API 30+ 是特殊权限，只能由用户去系统设置里给（`deviceStorageSettingsIntent`）；
    30 以下退回旧的运行时读写权限，所以 WRITE_EXTERNAL_STORAGE 带 maxSdkVersion。
    见 core/rootfs/DeviceStorage.kt。
  -->
  <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
    tools:ignore="ScopedStorage" />
  <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
    android:maxSdkVersion="29" />
  <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
    android:maxSdkVersion="29" />

  <!--
    「用 Claude 订阅登录」要把授权页交给外部浏览器（ui/components/ExternalBrowser.kt）。
    API 30+ 的包可见性下，不声明这一条就查不到有哪些浏览器，也就没法确认解析到的不是 Min 自己。
  -->
  <queries>
    <intent>
      <action android:name="android.intent.action.VIEW" />
      <category android:name="android.intent.category.BROWSABLE" />
      <data android:scheme="https" />
    </intent>
  </queries>

  <!--
    usesCleartextTraffic：不少中转站只有 http://。CLI 在 proot 里走自己的网络栈不受这个限制，
    但 App 自己查 /v1/models、npm 元数据时会被系统拦成 "Cleartext HTTP traffic not permitted"。
    向导和设置页对 http:// 地址都有明文风险提示，这里放行是和 CLI 保持一致。
  -->
  <application
    android:name=".MinApp"
    android:allowBackup="false"
    android:icon="@mipmap/ic_launcher"
    android:roundIcon="@mipmap/ic_launcher_round"
    android:label="@string/app_name"
    android:supportsRtl="true"
    android:theme="@style/Theme.Min"
    android:localeConfig="@xml/locales_config"
    android:usesCleartextTraffic="true"
    android:enableOnBackInvokedCallback="true"
    android:extractNativeLibs="true"
    tools:targetApi="33">

    <activity
      android:name=".MainActivity"
      android:theme="@style/Theme.Min.Splash"
      android:exported="true"
      android:launchMode="singleTask"
      android:windowSoftInputMode="adjustResize|stateAlwaysHidden"
      android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize|uiMode">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
      <!--
        一条链接导进一家中转：minc://v1/import?…，同时认 cc-switch 桌面端那套
        ccswitch://（别人分享的链接、它官网生成器产出的链接都是那个形状）。
        链接**只打开一个确认框**，从不静默入库 —— 它带的是一个会被立刻拿去发请求的 key。
      -->
      <intent-filter>
        <action android:name="android.intent.action.VIEW" />
        <category android:name="android.intent.category.DEFAULT" />
        <category android:name="android.intent.category.BROWSABLE" />
        <data android:scheme="minc" />
        <data android:scheme="ccswitch" />
      </intent-filter>
    </activity>

    <!--
      Claude Code 的 CLI 进程是 App 的子进程，App 一进 cached 状态整棵进程树都会被回收。
      前台服务是唯一能声明「正在替用户干活」的手段。类型声明两个：正常用 specialUse；
      部分 ROM 拒绝它时退回 dataSync（Android 15+ 每天限 6 小时）。
    -->
    <service
      android:name=".core.service.ClaudeCodeForegroundService"
      android:exported="false"
      android:foregroundServiceType="specialUse|dataSync">
      <property
        android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
        android:value="user-invoked local coding agent runtime" />
    </service>

    <!-- 通知上「允许/拒绝」按钮的接收端：后台等审批时不必先把 App 切回前台 -->
    <receiver
      android:name=".core.service.ClaudeCodePermissionReceiver"
      android:exported="false" />

    <!-- Codex 审批通知的同款接收端 -->
    <receiver
      android:name=".core.service.CodexApprovalReceiver"
      android:exported="false" />

    <!-- 无线调试配对：通知栏行内输入配对码（单机自配对时对话框不能失焦，见 AdbPairingReceiver） -->
    <receiver
      android:name=".privileged.AdbPairingReceiver"
      android:exported="false" />

    <!--
      设备操控：让 agent 读屏幕、替人点击输入。见 core/device/MinAccessibilityService.kt。

      exported 必须为 true 且带 BIND_ACCESSIBILITY_SERVICE——系统要绑定它。这个权限是
      签名级的，只有系统绑得上，第三方应用绑不了。**用户不去系统设置里手动开，
      这个服务一行代码都不会跑**。
    -->
    <service
      android:name=".core.device.MinAccessibilityService"
      android:exported="true"
      android:label="@string/app_name"
      android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
      <intent-filter>
        <action android:name="android.accessibilityservice.AccessibilityService" />
      </intent-filter>
      <meta-data
        android:name="android.accessibilityservice"
        android:resource="@xml/device_accessibility_service" />
    </service>

    <provider
      android:name="androidx.core.content.FileProvider"
      android:authorities="${applicationId}.fileprovider"
      android:exported="false"
      android:grantUriPermissions="true">
      <meta-data
        android:name="android.support.FILE_PROVIDER_PATHS"
        android:resource="@xml/file_paths" />
    </provider>

    <!--
      把 Rootfs 挂进系统「文件」App 与所有 SAF 选择器：/workspace 里的文件可以直接用
      任意第三方编辑器打开，不必再导出改完导入。见 core/rootfs/WorkspaceDocumentsProvider.kt。

      exported 必须为 true 才会出现在别的 App 的选择器里，而 MANAGE_DOCUMENTS 是签名级权限，
      只有系统的 DocumentsUI 拿得到——第三方 App 只能通过用户亲手选文件拿到那一份 URI 授权。
    -->
    <provider
      android:name=".core.rootfs.WorkspaceDocumentsProvider"
      android:authorities="${applicationId}.documents"
      android:exported="true"
      android:grantUriPermissions="true"
      android:permission="android.permission.MANAGE_DOCUMENTS">
      <intent-filter>
        <action android:name="android.content.action.DOCUMENTS_PROVIDER" />
      </intent-filter>
    </provider>

    <!--
      shell 进程（uid 2000）把 IPrivilegedService Binder 交回 App。
      必须 exported：壳和 App 不是同一 uid，exported=false 会直接拒掉。
      鉴权在 call() 里查 Binder.getCallingUid()==2000，见 PrivilegedBridgeProvider。
    -->
    <provider
      android:name=".privileged.PrivilegedBridgeProvider"
      android:authorities="${applicationId}.privileged"
      android:exported="true"
      android:grantUriPermissions="false" />
  </application>
</manifest>
