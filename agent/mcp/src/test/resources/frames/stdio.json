                    "type": "boolean"
                  }
                },
                "required": [
                  "messageType"
                ]
              },
              "annotations": {
                "readOnlyHint": true,
                "destructiveHint": false,
                "idempotentHint": true,
                "openWorldHint": false
              },
              "execution": {
                "taskSupport": "forbidden"
              }
            },
