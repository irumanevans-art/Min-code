{
  "mode": "default",
  "basis": "cc-permissions.md §Read and Edit：Edit 规则适用于所有改文件的内建工具（:339）；Read deny 也拦住同路径的 Edit 与 Write（:341）。",
  "calls": [
    {
      "tool": "Write",
      "input": {
        "file_path": "/workspace/secrets/a.txt",
        "content": "x"
      },
      "expected": "deny",
      "basis": "Edit deny 规则覆盖 Write（:339）。"
    },
    {
      "tool": "Edit",
      "input": {
        "file_path": "/workspace/.env",
        "old_string": "a",
        "new_string": "b"
      },
      "expected": "deny",
      "basis": "Read deny 同样拦住同路径的 Edit（:341）。"
    },
    {
      "tool": "Write",
      "input": {
        "file_path": "/workspace/other.txt",
        "content": "x"
      },
      "expected": "ask",
      "basis": "文件修改在 default 模式要批准（:19）。"
    }
  ]
}
