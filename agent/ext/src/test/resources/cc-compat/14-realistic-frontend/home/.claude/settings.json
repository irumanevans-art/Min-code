{
  "model": "sonnet",
  "env": {
    "EDITOR": "vim",
    "LANG": "en_US.UTF-8"
  },
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Read",
      "Grep",
      "Glob"
    ],
    "deny": [
      "Read(~/.ssh/**)",
      "Read(.env*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/welcome.sh"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "idle_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "notify-send 'Claude needs you'"
          }
        ]
      }
    ]
  }
}
