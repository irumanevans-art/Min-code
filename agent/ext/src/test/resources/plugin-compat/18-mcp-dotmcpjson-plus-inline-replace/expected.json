{
  "loads": true,
  "name": "mcp-merger",
  "nameSource": "manifest",
  "mcpServers": [
    {
      "key": "db",
      "serverName": "plugin:mcp-merger:db",
      "command": "node",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/server.js"
      ]
    },
    {
      "key": "cache",
      "serverName": "plugin:mcp-merger:cache",
      "command": "node",
      "args": [
        "./cache.js"
      ]
    }
  ],
  "basis": "PLG:305 装载顺序：.mcp.json 先、清单声明按序，同名服务器后者取代前者；CMP:814 同规则；CMP:806 .mcp.json 的 mcpServers 包裹可省"
}
