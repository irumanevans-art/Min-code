{
  "loads": true,
  "name": "tool-names",
  "nameSource": "manifest",
  "mcpServers": [
    {
      "key": "db",
      "serverName": "plugin:tool-names:db",
      "command": "node",
      "args": [
        "server.js"
      ],
      "toolName": {
        "tool": "query",
        "name": "mcp__plugin_tool-names_db__query"
      }
    }
  ],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__plugin_tool-names_db__query",
        "command": "audit.sh",
        "args": []
      }
    ]
  },
  "basis": "CMP:824 服务器在 /mcp 里叫 plugin:<插件>:<server>（mcp_tool hook 也用这个形）；CMP:825/:789 工具名 mcp__plugin_<插件>_<server>__<tool>——权限规则与 hook matcher 都必须写工具全名，只写服务器名永远不匹配"
}
