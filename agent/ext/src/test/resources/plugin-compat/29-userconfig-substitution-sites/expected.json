{
  "loads": true,
  "name": "ref-subst",
  "nameSource": "manifest",
  "enabled": true,
  "hooks": {
    "SessionStart": [
      {
        "matcher": null,
        "command": "${CLAUDE_PLUGIN_ROOT}/scripts/prepare.sh",
        "args": [
          "--endpoint",
          "${user_config.api_endpoint}"
        ],
        "resolvedCommand": "/plugins/cache/team-tools/ref-subst/1.0.0/scripts/prepare.sh",
        "resolvedArgs": [
          "--endpoint",
          "https://api.example.com"
        ],
        "exportSet": [
          "CLAUDE_PLUGIN_ROOT",
          "CLAUDE_PLUGIN_DATA",
          "CLAUDE_PROJECT_DIR",
          "CLAUDE_PLUGIN_OPTION_API_ENDPOINT",
          "CLAUDE_PLUGIN_OPTION_API_TOKEN"
        ]
      }
    ]
  },
  "mcpServers": [
    {
      "key": "api",
      "serverName": "plugin:ref-subst:api",
      "command": "node",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/server.js"
      ],
      "env": {
        "API_ENDPOINT": "${user_config.api_endpoint}",
        "API_KEY": "${user_config.api_token}"
      },
      "resolvedArgs": [
        "/plugins/cache/team-tools/ref-subst/1.0.0/server.js"
      ],
      "resolvedEnv": {
        "API_ENDPOINT": "https://api.example.com",
        "API_KEY": "tok-not-a-real-credential"
      },
      "exportSet": [
        "CLAUDE_PLUGIN_ROOT",
        "CLAUDE_PLUGIN_DATA"
      ]
    }
  ],
  "skills": [
    {
      "name": "ref-subst:run",
      "path": "skills/run/SKILL.md",
      "resolvedBodyContains": [
        "https://api.example.com",
        "/plugins/cache/team-tools/ref-subst/1.0.0/scripts/client.sh"
      ],
      "resolvedBodyExcludes": [
        "tok-not-a-real-credential"
      ]
    }
  ],
  "basis": "PLG:494 ${user_config.KEY} 替换进 MCP/LSP 配置、exec-form hook 的 args、skill 与 agent 正文；敏感值在 skill/agent 正文里变成占位符（占位符文本原文未说明，本样本只断言原值不出现）；PLG:495 每个选项以 CLAUDE_PLUGIN_OPTION_<KEY>（键大写）导出给 hook 进程；PLG:569/:571 变量在hook 的 command/args 与 MCP stdio 的 command/args/env 里解析；PLG:582 exec form 每个元素一个参数、无需引号；token 值是哑值，不是真实凭据"
}
